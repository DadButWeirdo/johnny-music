# ===== Johnny Music (runs on your phone) =====
# Use the SAME bot tokens as your main Johnny bot on Katabump, so it is one Johnny.
# This copy only handles the music commands (prefix only, e.g. ,play) and never registers slash commands.
# Keep this file private. Never upload it anywhere.

# Fill in the platform(s) you want music on. Leave the others untouched.
# Johnny's Yaper / Yapin bot token (same as on Katabump):
YAPPER_BOT_TOKEN=yb_paste_your_token_here

# Johnny's baff.gg bot token + Application ID (same as on Katabump):
BAFF_BOT_TOKEN=bfx_paste_your_token_here
BAFF_APP_ID=your_baff_application_id

# Command prefix for music commands. Set it to the same prefix Johnny uses on your servers (default is a comma).
# If you change Johnny's prefix with the prefix command later, change this too.
MUSIC_PREFIX=,

# "layout" (default) or "embed"
EMBED_STYLE=layout

# Data files (24/7 mode etc.). Defaults are fine.
# DATA_FILE=data/servers.json
# BAFF_DATA_FILE=data/baff/servers.json

# FFmpeg: on the phone it is installed with apt, so just use the system one.
MUSIC_FFMPEG=ffmpeg

# Optional player settings
# MUSIC_YTDLP_PATH=bin/yt-dlp
# MUSIC_MAX_QUEUE=50
# MUSIC_MAX_DURATION_SECONDS=14400
# MUSIC_YTDLP_AUTOUPDATE=0            # stop auto-updating yt-dlp
# MUSIC_YTDLP_CHANNEL=nightly         # stable | nightly | master
# MUSIC_YOUTUBE_COOKIES=cookies.txt   # only if YouTube says "Sign in to confirm you're not a bot"
# MUSIC_YTDLP_EXTRA_ARGS=--force-ipv4
